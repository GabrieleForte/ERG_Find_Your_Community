function startQuiz(){show('quiz');render()}
function render(){const q=questions[current];document.getElementById('bar').style.width=((current+1)/questions.length*100)+'%';document.getElementById('step').textContent=(current+1)+' of '+questions.length;document.getElementById('backBtn').style.visibility=current===0?'hidden':'visible';document.getElementById('error').textContent='';document.getElementById('questionHost').innerHTML=`<div class="question"><div class="question-tag">Question ${current+1}</div><h2>${q.title}</h2><div class="hint">${q.hint}</div><div class="options">${q.options.map((o,i)=>`<button class="option ${answers[current].includes(o[1])?'selected':''}" onclick="choose('${o[1]}')"><span class="icon">${o[2]}</span><span>${o[0]}</span></button>`).join('')}</div></div>`}
function choose(tag){const q=questions[current],a=answers[current],idx=a.indexOf(tag);if(idx>=0)a.splice(idx,1);else{if(a.length>=q.max){if(q.max===1)a.splice(0,1);else{document.getElementById('error').textContent=`You can select up to ${q.max} options.`;return}}a.push(tag)}render()}
function next(){if(!answers[current].length){document.getElementById('error').textContent='Select at least one answer to continue.';return}if(current<questions.length-1){current++;render()}else calculate()}
function back(){if(current>0){current--;render()}}
function isCoi(k){return ['leaders','living','renew','parenting'].includes(k)}
function communityType(k){return isCoi(k)?'Community of Interest':'Employee Resource Group'}
function logoFor(k){return logoMap[k]||logoMap.multicultural}
function vivaEngage(){window.open('https://engage.cloud.microsoft/','_blank')}
function showErgDetail(k){const c=communities[k];document.getElementById('ergDetail').innerHTML=`<strong>${c.name}</strong><br>${c.desc}<br><br><strong>About the ERG:</strong> ${c.find||c.why}<br><strong>Community focus:</strong> ${c.part||'Events, conversations, networking and community initiatives.'}<br><strong>Why it may be relevant:</strong> ${c.join||c.why}`}
function calculate(){
 let scores={};Object.keys(communities).forEach(k=>scores[k]=0);
 answers.flat().forEach(tag=>Object.entries(communities).forEach(([k,c])=>{
  if(c.tags.includes(tag))scores[k]+=4;
  if(tag==='network'&&['womens','leaders','multicultural'].includes(k))scores[k]+=2;
  if(tag==='impact'&&['renew','enabled'].includes(k))scores[k]+=2;
  if(tag==='inclusion'&&['enabled','pride','multicultural','womens'].includes(k))scores[k]+=2;
  if(tag==='career'&&['leaders','womens'].includes(k))scores[k]+=2;
  if(tag==='community'&&['multicultural','pride','parenting','living'].includes(k))scores[k]+=1;
 }));
 const ergKeys=Object.keys(communities).filter(k=>!isCoi(k));
 const coiKeys=Object.keys(communities).filter(k=>isCoi(k));
 const ergs=ergKeys.sort((a,b)=>scores[b]-scores[a]||communities[a].name.localeCompare(communities[b].name)).slice(0,2);
 const coi=coiKeys.sort((a,b)=>scores[b]-scores[a]||communities[a].name.localeCompare(communities[b].name))[0];
 const max=Math.max(scores[ergs[0]],1);
 const pct=(k,i)=>Math.max(68,Math.min(95,Math.round(76+(scores[k]/max)*17-i*5)));
 document.getElementById('ergMatches').innerHTML=ergs.map((k,i)=>{const c=communities[k],p=pct(k,i);return `<article class="final-match ${i===0?'primary':''}"><div class="final-rank">${i===0?'Primary ERG match':'Second ERG match'}</div><div class="final-top"><img class="final-logo" src="${logoFor(k)}" alt="${c.name} logo"><div><div class="final-type">Employee Resource Group</div><h3>${c.name}</h3></div><div class="final-score" style="--pct:${p}%"><span>${p}%</span></div></div><p><strong>Why it matches:</strong> ${c.why}</p><button class="btn join-btn" onclick="joinErg('${k}')">JOIN THE ERG</button></article>`}).join('');
 document.getElementById('ergTabs').innerHTML=ergs.map(k=>`<button class="final-tab" onclick="showErgDetail('${k}')">${communities[k].name}</button>`).join('');
 showErgDetail(ergs[0]);
 const c=communities[coi];document.getElementById('coiMatch').innerHTML=`<img src="${logoFor(coi)}" alt="${c.name} logo"><div><div class="final-type">Community of Interest</div><h3>${c.name}</h3><p>${c.desc}</p><p><strong>Why it matches:</strong> ${c.why}</p></div><button class="btn viva-btn" onclick="vivaEngage()">VISIT ON VIVA ENGAGE</button>`;
 show('result');window.scrollTo({top:0,behavior:'smooth'});
}
function joinErg(key){
  const c=communities[key];
  const configuredUrl=c.joinUrl||'';
  if(configuredUrl){window.open(configuredUrl,'_blank','noopener');return;}
  alert('The formal JOIN THE ERG link for '+c.name+' will be connected to the approved Baker Hughes enrollment process.');
}
function restart(){current=0;answers=[[],[],[]];show('welcome')}
</script>
